    },
    {
      "source": "/gallery/reg-demo/:path(.*)",
      "destination": "https://axiom-reg-demo.vercel.app/gallery/reg-demo/:path(.*)"
    },
    {
      "source": "/gallery/builder",
      "destination": "https://dashboard-builder-flax.vercel.app/gallery/builder"
    },
    {
      "source": "/gallery/builder/:path(.*)",
      "destination": "https://dashboard-builder-flax.vercel.app/gallery/builder/:path(.*)"
    },
    {
      "source": "/gallery/workflow",
      "destination": "https://co-snap-workflow-checker.vercel.app/gallery/workflow"
    },
    {
      "source": "/gallery/workflow/:path(.*)",
      "destination": "https://co-snap-workflow-checker.vercel.app/gallery/workflow/:path(.*)"
    },
    {
