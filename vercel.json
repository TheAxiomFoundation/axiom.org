    },
    {
      "source": "/government/:path(.*)",
      "destination": "https://axiom-government.vercel.app/government/:path(.*)"
    },
    {
      "source": "/advisors",
      "destination": "https://axiom-advisors.vercel.app/advisors"
    },
    {
      "source": "/advisors/:path(.*)",
      "destination": "https://axiom-advisors.vercel.app/advisors/:path(.*)"
    }
  ],
  "redirects": [
    {
      "source": "/receipt/api",
      "destination": "/receipt/api/",
      "permanent": false
    },
    {
      "source": "/chatbot",
      "destination": "/gallery/chatbot",
      "permanent": false
    },
    {
      "source": "/chatbot/:path(.*)",
      "destination": "/gallery/chatbot/:path(.*)",
      "permanent": false
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.axiom-foundation.org"
        }
      ],
      "destination": "https://axiom-foundation.org/:path",
      "permanent": true
    },
    {
      "source": "/pbif-proposal",
      "destination": "https://pbif-proposal.axiom-foundation.org/",
      "permanent": false
    },
    {
      "source": "/pbif-proposal/:path*",
      "destination": "https://pbif-proposal.axiom-foundation.org/:path*",
      "permanent": false
    },
    {
      "source": "/builder",
      "destination": "/gallery/builder",
      "permanent": false
    },
    {
      "source": "/builder/:path(.*)",
      "destination": "/gallery/builder/:path(.*)",
      "permanent": false
    },
    {
      "source": "/workflow",
      "destination": "/gallery/workflow",
      "permanent": false
    },
    {
      "source": "/workflow/:path(.*)",
      "destination": "/gallery/workflow/:path(.*)",
      "permanent": false
    },
    {
      "source": "/reg-demo",
      "destination": "/gallery/reg-demo",
      "permanent": false
    },
    {
      "source": "/reg-demo/:path(.*)",
      "destination": "/gallery/reg-demo/:path(.*)",
      "permanent": false
    },
    {
      "source": "/snap",
      "destination": "/gallery/cliffs",
      "permanent": false
    },
    {
      "source": "/cliffs",
      "destination": "/gallery/cliffs",
      "permanent": false
    },
    {
      "source": "/cliffs/:path(.*)",
      "destination": "/gallery/cliffs/:path(.*)",
      "permanent": false
    },
    {
      "source": "/gallery/snap",
      "destination": "/gallery/cliffs",
      "permanent": false
    },
    {
      "source": "/gallery/snap/:path(.*)",
      "destination": "/gallery/cliffs/:path(.*)",
      "permanent": false
    },
    {
      "source": "/snap/:path(.*)",
      "destination": "/gallery/cliffs/:path(.*)",
      "permanent": false
    },
    {
      "source": "/microsim",
      "destination": "/gallery/microsim",
      "permanent": false
    },
    {
      "source": "/microsim/:path(.*)",
      "destination": "/gallery/microsim/:path(.*)",
      "permanent": false
    },
    {
      "source": "/guidance",
      "destination": "/gallery/guidance",
      "permanent": false
    },
    {
      "source": "/guidance/:path(.*)",
      "destination": "/gallery/guidance/:path(.*)",
      "permanent": false
    }
  ]
}
