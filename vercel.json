    {
      "source": "/oracles/:path(.*)",
      "destination": "https://axiom-oracles.vercel.app/oracles/:path(.*)"
    },
    {
      "source": "/bills",
      "destination": "https://axiom-bills.vercel.app/bills"
    },
    {
      "source": "/bills/:path(.*)",
      "destination": "https://axiom-bills.vercel.app/bills/:path(.*)"
    },
    {
      "source": "/local",
      "destination": "https://axiom-local-pi.vercel.app/local"
    },
    {
      "source": "/local/:path(.*)",
      "destination": "https://axiom-local-pi.vercel.app/local/:path(.*)"
